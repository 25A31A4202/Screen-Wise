import streamlit as st

st.title("📱 SCREENWISE")
st.subheader("Screen Time Impact Analyzer")

st.write("Understand your screen time and reclaim your time!")

hours = st.number_input(
    "How many hours do you spend on screens every day?",
    min_value=0.0,
    max_value=24.0,
    step=0.5
)

if st.button("Analyze My Time"):
    weekly = hours * 7
    monthly = hours * 30
    yearly = hours * 365
    days = yearly / 24

    st.success("Analysis Complete!")

    st.write("### 📊 Your Screen Time")
    st.write(f"Daily: **{hours} hours**")
    st.write(f"Weekly: **{weekly} hours**")
    st.write(f"Monthly: **{monthly} hours**")
    st.write(f"Yearly: **{yearly} hours**")
    st.write(f"⏰ That's approximately **{days:.1f} days per year!**")